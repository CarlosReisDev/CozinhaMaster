<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CozinhaMaster Burger — Artesanal. Sem Concessões.</title>
  <meta name="description" content="Hambúrguer artesanal premium. Blend exclusivo 80/20, pão brioche fermentado 48h. Cada mordida, uma experiência." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body>

  <!-- ░░ NOISE OVERLAY ░░ -->
  <div class="noise-overlay" aria-hidden="true"></div>

  <!-- ░░ LOADER ░░ -->
  <div id="loader">
    <div class="loader-brand">
      <span class="loader-brand-main">COZINHAMASTER</span>
      <span class="loader-brand-sub">BURGER</span>
    </div>
    <div class="loader-progress">
      <div class="loader-bar-track">
        <div id="loader-bar"></div>
      </div>
      <span id="loader-percent">0%</span>
    </div>
    <span class="loader-status" id="loader-status">Preparando ingredientes…</span>
  </div>

  <!-- ░░ NAVBAR — PÍLULA FLUTUANTE ░░ -->
  <header class="site-header" id="site-header">
    <nav class="navbar-pill">
      <a href="#" class="navbar-logo">
        <img src="assets/images/Logo.png" alt="CozinhaMaster Burger" />
      </a>
      <ul class="navbar-links">
        <li><a href="#cardapio">Cardápio</a></li>
        <li><a href="#filosofia">Filosofia</a></li>
        <li><a href="#localizacao">Onde Estamos</a></li>
      </ul>
      <a href="#cta" class="navbar-cta">Reservar Mesa</a>
    </nav>
  </header>

  <!-- ░░ HERO STANDALONE — 100DVH ░░ -->
  <section class="hero-standalone" id="hero">
    <div class="hero-content">
      <span class="hero-label" data-gsap="hero-label">001 / EST. 2024</span>
      <h1 class="hero-heading">
        <span class="hero-word" data-gsap="hero-word">SÓ O</span>
        <span class="hero-word" data-gsap="hero-word">MELHOR</span>
        <span class="hero-word hero-word--accent" data-gsap="hero-word">INGREDIENTE</span>
        <span class="hero-word" data-gsap="hero-word">ENTRA.</span>
      </h1>
      <p class="hero-tagline" data-gsap="hero-tagline">
        Cada componente escolhido com propósito.<br />
        <span class="hero-tagline-mono">Blend 80/20 · Pão Madero · Ingredientes Selecionados</span>
      </p>
      <a href="#scroll-container" class="hero-cta" data-gsap="hero-cta">
        Ver o Processo
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M8 3v10M3 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
    <div class="hero-logo-aside" data-gsap="hero-logo">
      <img src="assets/images/Logo.png" alt="CozinhaMaster Burger" />
    </div>

    <div class="hero-scroll-indicator" data-gsap="hero-scroll">
      <span class="hero-scroll-text">ROLE PARA DESCOBRIR</span>
      <div class="hero-scroll-line"></div>
    </div>
  </section>

  <!-- ░░ CANVAS WRAP — FIXED, FULL VIEWPORT ░░ -->
  <div class="canvas-wrap" id="canvas-wrap">
    <canvas id="canvas"></canvas>
  </div>

  <!-- ░░ DARK OVERLAY — FIXED ░░ -->
  <div id="dark-overlay" aria-hidden="true"></div>

  <!-- ░░ MARQUEE — FIXED ░░ -->
  <div class="marquee-wrap" id="marquee-wrap" data-scroll-speed="-28" aria-hidden="true">
    <div class="marquee-text">
      BLEND 80/20&nbsp;&nbsp;·&nbsp;&nbsp;PÃO MADERO&nbsp;&nbsp;·&nbsp;&nbsp;SEM CONCESSÕES&nbsp;&nbsp;·&nbsp;&nbsp;INGREDIENTES DE PROCEDÊNCIA&nbsp;&nbsp;·&nbsp;&nbsp;ARTESANAL&nbsp;&nbsp;·&nbsp;&nbsp;BLEND 80/20&nbsp;&nbsp;·&nbsp;&nbsp;PÃO MADERO&nbsp;&nbsp;·&nbsp;&nbsp;SEM CONCESSÕES&nbsp;&nbsp;·&nbsp;&nbsp;
    </div>
  </div>

  <!-- ░░ SCROLL CONTAINER — 800VH ░░ -->
  <div id="scroll-container">

    <!-- FEATURE 1 — SLIDE-LEFT — 20-40% -->
    <section
      class="scroll-section section-content align-left"
      data-enter="20"
      data-leave="40"
      data-animation="slide-left"
      id="cardapio"
    >
      <div class="section-inner">
        <span class="section-label">002 / O Blend</span>
        <h2 class="section-heading">Blend<br />Exclusivo<br />80/20</h2>
        <p class="section-body">
          Contra-filé e acém selecionados a mão, na proporção que a ciência e o sabor confirmaram: 80% de magreza, 20% de gordura intramuscular. A equação do suculento.
        </p>
        <span class="section-note">v2.4 / Receita Testada em 4.200+ Hambúrgueres</span>
      </div>
    </section>

    <!-- FEATURE 2 — SLIDE-RIGHT — 40-60% -->
    <section
      class="scroll-section section-content align-right"
      data-enter="40"
      data-leave="60"
      data-animation="slide-right"
      id="processo"
    >
      <div class="section-inner">
        <span class="section-label">003 / O Pão</span>
        <h2 class="section-heading">Pão<br />Madero.<br />Original.</h2>
        <p class="section-body">
          O mesmo pão que consagrou a rede Madero. Casca dourada, miolo macio, estrutura que abraça o blend sem desmanchar. Um pão que já é referência — e aqui é padrão.
        </p>
        <span class="section-note">Fornecimento Direto Madero · Sem Substituição</span>
      </div>
    </section>

    <!-- STATS / MANIFESTO — STAGGER-UP — 60-78% -->
    <section
      class="scroll-section section-stats"
      data-enter="60"
      data-leave="78"
      data-animation="stagger-up"
      id="filosofia"
    >
      <div class="stats-manifesto">
        <div class="manifesto-block">
          <span class="section-label">004 / Manifesto</span>
          <p class="manifesto-contrast">
            <span class="manifesto-common">A maioria usa o que é mais barato.</span><br />
            <span class="manifesto-diff">Nós usamos o que é<br />mais correto.</span>
          </p>
        </div>
        <div class="stats-grid">
          <div class="stat">
            <span class="stat-number" data-value="80" data-decimals="0">0</span>
            <span class="stat-suffix">%</span>
            <span class="stat-label">Carne magra no blend</span>
          </div>
          <div class="stat">
            <span class="stat-number" data-value="1" data-decimals="0">0</span>
            <span class="stat-suffix">pão</span>
            <span class="stat-label">Só o Madero. Sem substituto.</span>
          </div>
          <div class="stat">
            <span class="stat-number" data-value="100" data-decimals="0">0</span>
            <span class="stat-suffix">%</span>
            <span class="stat-label">Ingredientes de procedência</span>
          </div>
          <div class="stat">
            <span class="stat-number" data-value="4.9" data-decimals="1">0</span>
            <span class="stat-suffix">★</span>
            <span class="stat-label">Avaliação média</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL — SCALE-UP — 78-100% — data-persist -->
    <section
      class="scroll-section section-cta"
      data-enter="78"
      data-leave="100"
      data-animation="scale-up"
      data-persist="true"
      id="cta"
    >
      <div class="cta-inner">
        <span class="section-label">005 / Reserve</span>
        <h2 class="cta-heading">
          Você Merece<br />
          <em>O Melhor.</em>
        </h2>
        <p class="cta-body">
          Blend selecionado. Pão Madero. Ingredientes com procedência.<br />
          Reserve sua mesa e experimente a diferença.
        </p>
        <div class="cta-actions">
          <a href="https://wa.me/5500000000000" class="cta-button cta-button--primary" target="_blank" rel="noopener">
            Reservar pelo WhatsApp
          </a>
          <a href="#cardapio" class="cta-button cta-button--ghost">
            Ver Cardápio
          </a>
        </div>
        <span class="cta-meta">Terça a Domingo · 18h às 23h · Rua dos Sabores, 404</span>
      </div>
    </section>

  </div><!-- /#scroll-container -->

  <!-- ░░ FOOTER ░░ -->
