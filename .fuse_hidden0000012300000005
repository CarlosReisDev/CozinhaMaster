    <div class="footer-inner">
      <div class="footer-brand">
        <img src="assets/images/Logo.png" alt="CozinhaMaster Burger" class="footer-logo" />
        <p class="footer-tagline">Artesanal. Sem Concessões.</p>
      </div>
      <div class="footer-info">
        <div class="footer-col">
          <span class="footer-col-title">Horários</span>
          <p>Ter — Sex: 18h às 23h</p>
          <p>Sáb — Dom: 12h às 23h</p>
          <p>Segunda: Fechado</p>
        </div>
        <div class="footer-col">
          <span class="footer-col-title">Contato</span>
          <p>WhatsApp: (00) 00000-0000</p>
          <p>@cozinhamaster</p>
        </div>
        <div class="footer-col">
          <span class="footer-col-title">Localização</span>
          <p>Rua dos Sabores, 404</p>
          <p>Bairro Premium, Cidade</p>
        </div>
      </div>
      <div class="footer-status">
        <span class="status-dot"></span>
        <span class="status-text">Aberto Agora</span>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2024 CozinhaMaster Burger</span>
      <span class="footer-mono">v1.0 · Todos os direitos reservados</span>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/lenis@1/dist/lenis.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
